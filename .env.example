# Local development only. Never commit real secrets.
APP_URL=http://localhost:3000

POSTGRES_SUPERUSER_PASSWORD=change-me
CADENCIA_OWNER_PASSWORD=change-me
CADENCIA_APP_PASSWORD=change-me
REDIS_PASSWORD=change-me

DATABASE_URL=postgres://cadencia_app:change-me@127.0.0.1:5432/cadencia
DATABASE_MIGRATION_URL=postgres://cadencia_owner:change-me@127.0.0.1:5432/cadencia
TEST_DATABASE_URL=postgres://cadencia_app:change-me@127.0.0.1:5432/cadencia_test
TEST_DATABASE_MIGRATION_URL=postgres://cadencia_owner:change-me@127.0.0.1:5432/cadencia_test
REDIS_URL=redis://:change-me@127.0.0.1:6379

SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="Cadência <nao-responda@cadencia.local>"

# Number of reverse proxies in front of the app that append to X-Forwarded-For.
TRUSTED_PROXY_HOPS=0
# Secret used to HMAC IP addresses and emails before storing them in security logs (LGPD data minimization).
PII_HASH_SECRET=change-me

# Production with more than one instance: a stable shared key for Server Action encryption.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
