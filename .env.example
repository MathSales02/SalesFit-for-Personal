# Local development only. Never commit real secrets.
APP_URL=http://localhost:3000

POSTGRES_SUPERUSER_PASSWORD=change-me
CADENCIA_OWNER_PASSWORD=change-me
CADENCIA_APP_PASSWORD=change-me
REDIS_PASSWORD=change-me

DATABASE_URL=postgres://cadencia_app:change-me@127.0.0.1:5442/cadencia
DATABASE_MIGRATION_URL=postgres://cadencia_owner:change-me@127.0.0.1:5442/cadencia
TEST_DATABASE_URL=postgres://cadencia_app:change-me@127.0.0.1:5442/cadencia_test
TEST_DATABASE_MIGRATION_URL=postgres://cadencia_owner:change-me@127.0.0.1:5442/cadencia_test
REDIS_URL=redis://:change-me@127.0.0.1:6389
TEST_REDIS_URL=redis://:change-me@127.0.0.1:6389

SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="Cadência <nao-responda@cadencia.local>"

# Number of reverse proxies in front of the app that append to X-Forwarded-For.
TRUSTED_PROXY_HOPS=0
# Secret used to HMAC IP addresses and emails before storing them in security logs (LGPD data minimization).
PII_HASH_SECRET=change-me

# Encrypts MFA (authenticator app) secrets at rest. At least 32 random characters.
MFA_ENCRYPTION_KEY=change-me-change-me-change-me-change-me

# Production with more than one instance: a stable shared key for Server Action encryption.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Private object storage for videos and images (S3 API; SeaweedFS locally).
S3_ENDPOINT=http://127.0.0.1:8333
# Origin the browser uses for uploads and playback (a CDN or the bucket host in production).
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=cadencia-media
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
TEST_S3_BUCKET=cadencia-media-test

# Asaas payments (optional; without a key, admins manage subscriptions by hand).
# Sandbox: https://api-sandbox.asaas.com/v3 · Production: https://api.asaas.com/v3
# Keys start with "$": write it escaped as \$aact_... so Next.js does not expand it.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Long random secret, also configured in the Asaas webhook settings (header asaas-access-token).
ASAAS_WEBHOOK_TOKEN=
